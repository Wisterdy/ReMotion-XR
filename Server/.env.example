# Copy to .env for local overrides. Never commit a real .env.
DATA_DIR=./data
REMOTION_STUB_DELAY_SECONDS=0.4
# --- Credential boundaries (never mix these up) ---
# Gateway app credential: Quest sends it as X-API-Key to the FastAPI
# gateway only. It does NOT authenticate RunPod.
# REMOTION_API_KEY=
# Server-side RunPod platform credential (gateway/worker env only,
# never in the APK or Settings UI):
# RUNPOD_API_KEY=
# RUNPOD_NETWORK_VOLUME_ID comes from GitHub Secrets in production.
# SAM worker only (accepted facebook/sam-3d-objects read token):
# HF_TOKEN=
# SAM3D_MODEL_REVISION=2e73555018d2741ccd486e56c24fac41155a1dc6
# Meta Model API (automatic object identification + SAM 3.1 cut-outs).
# Set from the Model API dashboard; never commit a real key.
# MODEL_API_KEY=
# REDIS_URL=redis://localhost:6379/0
