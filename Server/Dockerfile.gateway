FROM python:3.12-slim
WORKDIR /code
RUN pip install --no-cache-dir fastapi==0.115.12 uvicorn==0.34.2 python-multipart==0.0.20 pydantic==2.11.4 httpx==0.28.1 numpy==2.2.5 openai==1.78.1
COPY app ./app
RUN python -c "from app.main import app; assert app"
ENV REMOTION_REQUIRE_REMOTE=1 PYTHONUNBUFFERED=1
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
